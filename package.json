{
  "name": "tailwind-variant-groups",
  "version": "0.1.0",
  "description": "UnoCSS-style variant groups for Tailwind CSS 4.1–4.x and Next.js 16",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./postcss": {
      "import": {
        "types": "./dist/postcss.d.ts",
        "default": "./dist/postcss.js"
      },
      "require": {
        "types": "./dist/postcss.d.cts",
        "default": "./dist/postcss.cjs"
      }
    },
    "./loader": {
      "types": "./dist/loader.d.cts",
      "require": "./dist/loader.cjs",
      "default": "./dist/loader.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.loader.config.ts && node scripts/copy-cjs-declarations.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "pnpm build && node scripts/test-package-types.mjs",
    "test:next": "pnpm build && node scripts/test-next-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm test:package && pnpm test:next"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "fast-glob": "^3.3.3",
    "magic-string": "^0.30.18"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": ">=4.1 <5",
    "next": ">=16 <17",
    "postcss": "^8.4.0",
    "tailwindcss": ">=4.1 <5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^16.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
